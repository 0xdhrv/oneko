{
  "name": "oneko",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "registry:build": "shadcn build && node scripts/build-registry.mjs && oxfmt public/r/*.json",
    "prebuild": "pnpm run registry:build",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "pnpm build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "pnpm build:cloudflare && opennextjs-cloudflare deploy",
    "deploy:check": "pnpm build:cloudflare && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate:favicons": "node scripts/generate-favicons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:browser:fixture": "vite --config tests/browser/vite.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.7",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "@shikijs/langs": "4.4.3",
    "@vercel/analytics": "2.0.1",
    "@web-kits/audio": "^0.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "postcss": "^8.5",
    "shadcn": "^4.3.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "to-ico": "^1.1.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "wrangler": "4.144.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
